NEXT_PUBLIC_SITE_URL=https://www.sebmonty.link

# Optional: required only for the email subscription endpoint.
MAILERLITE_API_KEY=
MAILERLITE_GROUP_ID=

# Optional: Breakpoint guide (/breakpoint). The public guide works without these.
# Editorial desk and live coverage need an Upstash Redis store connected in Vercel (adds KV_REST_API_URL / KV_REST_API_TOKEN)
# plus two long random tokens. See breakpoint/README.md.
KV_REST_API_URL=
KV_REST_API_TOKEN=
BREAKPOINT_EDITOR_TOKEN=
BREAKPOINT_INGEST_TOKEN=

# Optional: free Jupiter API key (developers.jup.ag/portal) for token prices on /breakpoint.
# Without it the guide uses Jupiter's keyless access, which has a lower rate limit.
JUPITER_API_KEY=

# Studio (/studio). See docs/studio.md.
# Postgres connection string. Use Neon's pooled URL (host contains "-pooler").
DATABASE_URL=
# Long random secret for sign-in sessions: `openssl rand -hex 32`
BETTER_AUTH_SECRET=
# Optional: the site's public URL, e.g. https://www.sebmonty.link (worked out from the request if empty)
BETTER_AUTH_URL=
# One-time code for creating the first admin at /studio/setup. Remove it after setup.
STUDIO_SETUP_TOKEN=
# Set automatically when a Vercel Blob store is connected to the project
BLOB_READ_WRITE_TOKEN=
