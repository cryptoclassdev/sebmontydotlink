NEXT_PUBLIC_SITE_URL=https://www.sebmonty.link
NEXT_PUBLIC_SANITY_PROJECT_ID=bfn64pgm
NEXT_PUBLIC_SANITY_DATASET=production

# Optional: required only for the email subscription endpoint.
MAILERLITE_API_KEY=
MAILERLITE_GROUP_ID=

# Optional: Breakpoint guide (/breakpoint). The public guide works without these.
# Editorial desk and live coverage need an Upstash Redis store connected in Vercel (adds KV_REST_API_URL / KV_REST_API_TOKEN)
# plus two long random tokens. See breakpoint/README.md.
KV_REST_API_URL=
KV_REST_API_TOKEN=
BREAKPOINT_EDITOR_TOKEN=
BREAKPOINT_INGEST_TOKEN=

# Optional: free Jupiter API key (developers.jup.ag/portal) for token prices on /breakpoint.
# Without it the guide uses Jupiter's keyless access, which has a lower rate limit.
JUPITER_API_KEY=
