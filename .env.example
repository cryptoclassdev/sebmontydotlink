NEXT_PUBLIC_SITE_URL=https://www.sebmonty.link
NEXT_PUBLIC_SANITY_PROJECT_ID=bfn64pgm
NEXT_PUBLIC_SANITY_DATASET=production

# Optional: required only for the email subscription endpoint.
MAILERLITE_API_KEY=
MAILERLITE_GROUP_ID=

# Studio (/studio). See docs/studio.md.
# Postgres connection string. Use Neon's pooled URL (host contains "-pooler").
DATABASE_URL=
# Long random secret for sign-in sessions: `openssl rand -hex 32`
BETTER_AUTH_SECRET=
# Optional: the site's public URL, e.g. https://www.sebmonty.link (worked out from the request if empty)
BETTER_AUTH_URL=
# One-time code for creating the first admin at /studio/setup. Remove it after setup.
STUDIO_SETUP_TOKEN=
# Set automatically when a Vercel Blob store is connected to the project
BLOB_READ_WRITE_TOKEN=
